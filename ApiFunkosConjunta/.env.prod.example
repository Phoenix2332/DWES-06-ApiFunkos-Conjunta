SMTP_FROM_NAME=ApiFunkos
SMTP_ADMIN_EMAIL=CAMBIAR_POR_TU_EMAIL_DE_ADMIN
SMTP_SECURITY=Tls

# JWT
JWT_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
