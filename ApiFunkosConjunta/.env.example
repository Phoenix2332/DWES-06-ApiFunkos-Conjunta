# JWT - Autenticación
Jwt__Key=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=ApiFunkosConjunta
Jwt__Audience=ApiFunkosConjunta
Jwt__AdminUsername=admin
Jwt__AdminPassword=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# PostgreSQL
ConnectionStrings__PostgreSQL=Host=postgres;Port=5432;Database=ApiFunkos;Username=postgres;Password=CAMBIAR_CONTRASENA

# Redis
ConnectionStrings__Redis=redis:6379

# MongoDB
MongoDB__ConnectionString=mongodb://admin:CAMBIAR_CONTRASENA@mongodb:27017/?authSource=admin
MongoDB__DatabaseName=ApiFunkos

# SMTP - Envio de correos (Gmail con contrasena de aplicacion)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=CAMBIAR_POR_TU_CUENTA@gmail.com
Smtp__Password=CAMBIAR_POR_TU_CONTRASENA_DE_APLICACION
