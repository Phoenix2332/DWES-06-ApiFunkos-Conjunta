meta {
  name: Crear categoria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/categorias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Categoria Bruno"
  }
}

script:post-response {
  test("Devuelve 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  if (res.status === 201) {
    bru.setEnvVar("categoriaId", res.body.id);
  }
}