meta {
  name: Listar Categorias
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "{ categorias { items { id nombre } total pagina tamanoPagina } }"
  }
}

script:post-response {
  test("Devuelve 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("No contiene errores GraphQL", function() {
    expect(res.body.errors).to.be.undefined;
  });
}