meta {
  name: Obtener Categoria por ID
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "query { categoria(id: \"XdkInZ9R09j\") { id nombre } }"
  }
}

script:post-response {
  test("Devuelve 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("No contiene errores GraphQL", function() {
    expect(res.body.errors).to.be.undefined;
  });
}