script:pre-request {
  bru.setEnvVar("categoriaId", "");
  bru.setEnvVar("proveedorId", "");
  bru.setEnvVar("funkoId", "");
}

meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "Admin123!"
  }
}

script:post-response {
  test("Devuelve 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}