meta {
  name: Categoria inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "{ categoria(id: \"99999999999\") { id nombre } }"
  }
}

script:post-response {
  test("Devuelve 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Contiene errores GraphQL", function() {
    expect(res.body.errors).to.be.an("array");
    expect(res.body.errors.length).to.be.greaterThan(0);
  });
}