meta {
  name: Obtener Funko por ID
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "query { funko(id: 1) { id nombre categoriaId proveedorId stock precio imagen } }"
  }
}

script:post-response {
  test("Devuelve 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("No contiene errores GraphQL", function() {
    expect(res.body.errors).to.be.undefined;
  });
}